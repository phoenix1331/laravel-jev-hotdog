# Shared look for every tape: the app's ink, mustard, relish and ketchup.
Set Shell "bash"
Set FontSize 18
Set Width 1400
Set Height 760
Set Padding 28
Set TypingSpeed 45ms
Set CursorBlink false
Set WindowBar Colorful
Set Theme { "name": "Hotdog", "background": "#14213d", "foreground": "#eef1f7", "cursor": "#f2a900", "selection": "#2b3a5c", "black": "#0e1830", "red": "#ff6b7f", "green": "#5fd38d", "yellow": "#f2a900", "blue": "#7aa2f7", "magenta": "#c792ea", "cyan": "#7fdbca", "white": "#d9dde6", "brightBlack": "#5a6785", "brightRed": "#ff8f9e", "brightGreen": "#86e3a9", "brightYellow": "#ffc94d", "brightBlue": "#a3bfff", "brightMagenta": "#dcb3f5", "brightCyan": "#a8eedf", "brightWhite": "#ffffff" }
